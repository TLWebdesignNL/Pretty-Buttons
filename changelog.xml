<?xml version="1.0" encoding="utf-8"?>
<changelogs>
    <changelog>
        <element>mod_prettybuttons</element>
        <type>module</type>
        <version>1.2.0</version>
        <security>
            <item>Improved output escaping for safer button rendering</item>
            <item>Improved security for links that open in a new tab</item>
        </security>
        <fix>
            <item>Improved installer/update compatibility for Joomla 6</item>
            <item>Improved compatibility with newer PHP versions</item>
            <item>Improved update cleanup of legacy files</item>
        </fix>
        <addition>
            <item>Added Joomla 6 support</item>
            <item>Added global "Enable Custom ARIA Label" setting in the Buttons fieldset</item>
            <item>Added optional per-button ARIA label field in the button subform</item>
        </addition>
        <language>
            <item>Fixed typos in English language file</item>
        </language>
    </changelog>
